# ==========================================
# NOVA DECK AI — Environment Configuration
# ==========================================
# Copy these variables into your Vercel Project Settings -> Environment Variables.

# 1. Google Gemini API Key (Required for real AI generation)
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY="your_google_gemini_api_key_here"

# 2. JWT Authentication Secret
JWT_SECRET="novadeck_super_secure_secret_key_change_in_production_2026_xyz"

# 3. Database URL (SQLite default or Cloud PostgreSQL)
DATABASE_URL="file:./dev.db"

# 4. Application URL
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# 5. Image Provider (Optional)
IMAGE_PROVIDER="placeholder"
UNSPLASH_ACCESS_KEY=""
